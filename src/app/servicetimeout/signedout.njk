{% extends "base-template.njk" %}
{% block content %}
  <h1 class="govuk-heading-l">You have been signed out</h1>
  <p class="govuk-body">For your security, the system signed you out after 1 hour of inactivity.</p>
  <p class="govuk-body">In progress changes may not have been saved.</p>
  <p class="govuk-body">Sign in to view and manage your reports.</p>
  <a href="/login" role="button" class="govuk-button govuk-!-margin-top-2">Sign in</a>
{% endblock %}
