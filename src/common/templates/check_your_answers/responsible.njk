{% set responsibleAddress = 
  (garfile.responsibleAddressLine1 or '') ~ '<br>' ~
  (garfile.responsibleAddressLine2 or '') ~ '<br>' ~
  (garfile.responsibleTown or '') ~ '<br>' ~
  (garfile.responsibleCountryLabel or '') ~ '<br>' ~
(garfile.responsiblePostcode or '') %}

{% set rows = [
  { key: { html: __('field_given_name') }, value: { text: garfile.responsibleGivenName or '' } },
  { key: { html: __('field_surname') }, value: { text: garfile.responsibleSurname or '' } },
  { key: { html: __('field_address') }, value: { html: responsibleAddress } },
  { key: { html: __('field_contact_details') }, value: { text: garfile.responsibleContactNo or '' } },
  { key: { html: __('field_email') }, value: { text: garfile.responsibleEmail or '' } }
] %}

{% if garfile.fixedBasedOperator != "Other" %}
  {% set _ = rows.push({
    key: { html: __('field_fbo_question') },
    value: { text: garfile.fixedBasedOperator or '' }
  }) %}
{% else %}
  {% set _ = rows.push({
    key: { html: __('field_fbo_question_review') },
    value: { text: garfile.fixedBasedOperatorAnswer | truncate(50) | default('') }
  }) %}
{% endif %}

<div id="responsiblePerson"></div>
{{ govukSummaryList({
  card: {
    title: {
      text: __('heading_responsible_person_details')
    },
    actions: showChangeLinks and {
      items: [
        {
          href: "/garfile/resperson",
          text: __('change_prefix'),
          visuallyHiddenText: __('heading_responsible_person_details')
        }
      ]
    }
  },
  rows: rows })
}}
