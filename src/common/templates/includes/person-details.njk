{% import "common/templates/includes/date-time.njk" as dt %}
{% import "common/templates/includes/macros.njk" as common %}
{% set dateOfBirth = person.dateOfBirth or req.body['dobYear'] ~ "-" ~ req.body['dobMonth'] ~ "-" ~req.body['dobDay'] %}
{% set documentExpiryDate = person.documentExpiryDate or req.body['expiryYear'] ~ "-" ~ req.body['expiryMonth'] ~ "-" ~req.body['expiryDay'] %}
<div class="{{ m.form_group_class('savedpeople', errors) }}">
  <script type="module" src="/javascripts/includes/person-details.js"></script>
  {% set personTypeItems = [] %}
  {% for choice in persontype %}
    {% set item = {
      value: choice.persontype,
      text: choice.persontype,
      hint: {
        text: choice.description
      },
      checked: (person.peopleType.name == choice.persontype) or (req.body.personType == choice.persontype)
    } %}
    {% set personTypeItems = personTypeItems.concat(item) %}
  {% endfor %}
  {{ govukRadios({
    idPrefix: "personType",
    name: "personType",
    fieldset: {
      legend: {
        text: __("field_person_type"),
        classes: "govuk-fieldset__legend--m"
      }
    },
    classes: m.form_group_class('personType', errors),
    hint: {
      html: personTypeHintHtml
    },
    errorMessage: errors | containsError('personType'),
    items: personTypeItems
  }) }}
  <h2 class="govuk-heading-m">{{ __('heading_travel_document_details') }}</h2>
  <p class="govuk-body">
    Provide the details as shown on their travel document. Check the
    <a href="https://www.gov.uk/guidance/visiting-the-uk-as-an-eu-eea-or-swiss-citizen"
       target="_blank"
       class="govuk-link">guidance on travel documents that can be used to enter the UK</a>.
  </p>
  {% set otherDocumentTypeHtml %}
    <div class="{{ m.form_group_class('travelDocumentOther', errors) }} govuk-!-margin-left-3"
         id="travelDocumentOtherDiv"
         {{ "hidden" if person.documentType !== 'Other' }}>
      {{ govukInput({
        id: "travelDocumentOther",
        name: "travelDocumentOther",
        value: person.documentDesc or req.body.documentDesc,
        maxlength: MAX_STRING_LENGTH - 10,
        type: "text",
        autocomplete: "off",
        spellcheck: false,
        classes: "govuk-!-width-one-half",
        label: {
          text: "Travel document type"
        },
        errorMessage: errors | containsError('travelDocumentOther')

      }) }}
    </div>
  {% endset %}

  {% set documentTypeItems = [] %}
  {% for choice in documenttype %}

    {% set item = {
      value: choice.documenttype,
      text: choice.documenttype,
      hint: {
        text: choice.description
      },
      conditional: {
        html: otherDocumentTypeHtml if choice.documenttype == 'Other'
      },
      checked: (person.documentType == choice.documenttype) or (req.body.travelDocumentType == choice.documenttype)
    } %}
    {% set documentTypeItems = documentTypeItems.concat(item) %}
  {% endfor %}
  {{ govukRadios({
    idPrefix: "travelDocumentType",
    name: "travelDocumentType",
    fieldset: {
      legend: {
        text: __("field_travel_document_type"),
        classes: "govuk-fieldset__legend--m"
      }
    },
    classes: m.form_group_class('travelDocumentType', errors),
    errorMessage: errors | containsError('travelDocumentType'),
    items: documentTypeItems
  }) }}
  {{ govukInput({
    id: "travelDocumentNumber",
    name: "travelDocumentNumber",
    classes: "govuk-input--width-20",
    label: {
      text: __("field_travel_document_number"),
      classes: "govuk-label--m"
    },
    value: person.documentNumber or req.body.travelDocumentNumber,
    attributes: {
      maxlength: MAX_STRING_LENGTH
    },
    hint: {
      text: 'For example, 50213526'
    },
    errorMessage: errors | containsError('travelDocumentNumber')
  }) }}
  {{ govukInput({
    id: "firstName",
    name: "firstName",
    classes: "govuk-input--width-30",
    label: {
      text: __("field_given_name"),
      classes: "govuk-label--m"
    },
    hint: {
      text: __("field_given_name_hint")
    },
    value: person.firstName or req.body.firstName,
    attributes: {
      maxlength: MAX_STRING_LENGTH,
      autocomplete: "off"
    },
    errorMessage: errors | containsError('firstName')
  }) }}
  {{ govukInput({
    id: "lastName",
    name: "lastName",
    classes: "govuk-input--width-30",
    label: {
      text: __("field_surname"),
      classes: "govuk-label--m"
    },
    hint: {
      text: __("field_surname_hint")
    },
    value: person.lastName or req.body.lastName,
    attributes: {
      maxlength: MAX_STRING_LENGTH,
      autocomplete: "off"
    },
    errorMessage: errors | containsError('lastName')
  }) }}
  {{ dt.dateInput('dob', cookie, dateOfBirth, "field_dob", "field_dob_hint", errors, __) }}
  {{ govukInput({
    id: "birthplace",
    name: "birthplace",
    classes: "govuk-input--width-30",
    label: {
      text: __("field_birth_place"),
      classes: "govuk-label--m"
    },
    value: person.placeOfBirth or req.body.birthplace,
    attributes: {
      maxlength: MAX_STRING_LENGTH,
      autocomplete: "off"
    },
    errorMessage: errors | containsError('birthplace')
  }) }}
  {% set genderItems = [] %}
  {% for choice in genderchoice %}
    {% set item = {
      value: choice.gender,
      text: choice.gender,
      checked: (person.gender == choice.gender) or (req.body.gender == choice.gender)
    } %}
    {% set genderItems = genderItems.concat(item) %}
  {% endfor %}
  {{ govukRadios({
    idPrefix: "gender",
    name: "gender",
    fieldset: {
      legend: {
        text: __("field_gender"),
        classes: "govuk-fieldset__legend--m"
      }
    },
    classes: m.form_group_class('gender', errors),
    hint: {
      text: __("field_gender_hint")
    },
    errorMessage: errors | containsError('gender'),
    items: genderItems
  }) }}
  {% set nationalityItems = [{"value": "", "text": ""}] %}
  {{ common.countryList(
    "nationality",
    nationalityList,
    (person.nationality or req.body.nationality),
    __("field_nationality"),
    __("field_nationality_hint"),
    errors | containsError('nationality')
  ) }}
  {% set issuingStateItems = [] %}
  {{ common.countryList(
    "issuingState",
    nationalityList,
    (person.issuingState or req.body.issuingState),
    __("field_issuing_state"),
    __("field_issuing_state_hint"),
    errors | containsError('issuingState')
  ) }}
  {{ dt.dateInput('expiry', cookie, documentExpiryDate, "field_document_expiry_date", "field_document_expiry_date_hint", errors, __) }}
</div>
